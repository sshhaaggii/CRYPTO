#include <stdio.h>
#include <ctype.h>
int main(void){
 char s[500],key[]="CIPHER"; char map[26]; int used[26]={0},n=0;
 for(int i=0;key[i];i++){int x=key[i]-'A';if(!used[x]){map[n++]=key[i];used[x]=1;}}
 for(char c='A';c<='Z';c++)if(!used[c-'A'])map[n++]=c;
 printf("Plaintext: ");fgets(s,sizeof s,stdin);
 printf("Cipher alphabet: ");for(int i=0;i<26;i++)putchar(map[i]);puts("");
 for(int i=0;s[i];i++)if(isalpha((unsigned char)s[i])){
   int x=toupper((unsigned char)s[i])-'A';char c=map[x];
   s[i]=islower((unsigned char)s[i])?(char)tolower(c):c;
 }
 printf("Ciphertext: %s",s);return 0;
}
