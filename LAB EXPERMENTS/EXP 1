#include <stdio.h>
#include <string.h>

int main()
{
    char text[100], ch;
    int key, i;

    printf("Enter the text: ");
    fgets(text, sizeof(text), stdin);

    printf("Enter the key: ");
    scanf("%d", &key);

    for (i = 0; text[i] != '\0'; i++)
    {
        ch = text[i];

        if (ch >= 'A' && ch <= 'Z')
        {
            text[i] = (ch - 'A' + key) % 26 + 'A';
        }
        else if (ch >= 'a' && ch <= 'z')
        {
            text[i] = (ch - 'a' + key) % 26 + 'a';
        }
    }

    printf("Encrypted text: %s", text);

    return 0;
}
