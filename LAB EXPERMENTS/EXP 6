
#include <stdio.h>

int main() {
    int a, b, p1 = 4, p2 = 19;
    int c1 = 1, c2 = 20;
    int i, j;

    printf("Possible affine cipher keys:\n");

    for (a = 1; a < 26; a++) {
        int valid = 1;

        for (i = 1; i < 26; i++) {
            if ((a * i) % 26 == 0) {
                valid = 0;
                break;
            }
        }

        if (valid) {
            for (b = 0; b < 26; b++) {
                if ((a * p1 + b) % 26 == c1 &&
                    (a * p2 + b) % 26 == c2) {
                    printf("a = %d, b = %d\n", a, b);
                }
            }
        }
    }

    printf("\nAssuming B maps from E and U maps from T,\n");
    printf("the key is a = 17, b = 11.\n");

    return 0;
}
