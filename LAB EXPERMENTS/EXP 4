#include <stdio.h>
#include <string.h>

int main()
{
    char text[100];
    int a, b, i, p;

    printf("Enter the text: ");
    scanf("%s", text);

    printf("Enter value of a: ");
    scanf("%d", &a);

    printf("Enter value of b: ");
    scanf("%d", &b);

    for (i = 0; text[i] != '\0'; i++)
    {
        if (text[i] >= 'A' && text[i] <= 'Z')
        {
            p = text[i] - 'A';
            text[i] = (a * p + b) % 26 + 'A';
        }
        else if (text[i] >= 'a' && text[i] <= 'z')
        {
            p = text[i] - 'a';
            text[i] = (a * p + b) % 26 + 'a';
        }
    }

    printf("Encrypted text: %s", text);

    return 0;
}
