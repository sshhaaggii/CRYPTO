#include <stdio.h>
#include <string.h>

int main()
{
    char text[100];
    char key[27] = "QWERTYUIOPASDFGHJKLZXCVBNM";
    int i, index;

    printf("Enter the text: ");
    fgets(text, sizeof(text), stdin);

    for (i = 0; text[i] != '\0'; i++)
    {
        if (text[i] >= 'A' && text[i] <= 'Z')
        {
            index = text[i] - 'A';
            text[i] = key[index];
        }
        else if (text[i] >= 'a' && text[i] <= 'z')
        {
            index = text[i] - 'a';
            text[i] = key[index] + 32;
        }
    }

    printf("Encrypted text: %s", text);

    return 0;
}
