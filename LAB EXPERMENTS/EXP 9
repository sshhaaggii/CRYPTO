#include <stdio.h>
#include <ctype.h>
#include <string.h>
int main(void){
 char key[100],ct[1000],sq[25];int used[26]={0},n=0;
 printf("Keyword: ");scanf("%99s",key);
 for(int pass=0;pass<2;pass++){char *p=pass?"ABCDEFGHIJKLMNOPQRSTUVWXYZ":key;
  for(int i=0;p[i];i++){char c=toupper((unsigned char)p[i]);if(c=='J')c='I';
   if(c>='A'&&c<='Z'&&!used[c-'A']){used[c-'A']=1;sq[n++]=c;}}}
 printf("Ciphertext (even number of letters): ");scanf("%999s",ct);
 int len=(int)strlen(ct);if(len%2){puts("Ciphertext length must be even.");return 1;}
 for(int i=0;i<len;i+=2){char x=toupper(ct[i]),y=toupper(ct[i+1]);if(x=='J')x='I';if(y=='J')y='I';
  int r1=0,c1=0,r2=0,c2=0;
  for(int j=0;j<25;j++){if(sq[j]==x){r1=j/5;c1=j%5;}if(sq[j]==y){r2=j/5;c2=j%5;}}
  if(r1==r2){putchar(sq[r1*5+(c1+4)%5]);putchar(sq[r2*5+(c2+4)%5]);}
  else if(c1==c2){putchar(sq[((r1+4)%5)*5+c1]);putchar(sq[((r2+4)%5)*5+c2]);}
  else {putchar(sq[r1*5+c2]);putchar(sq[r2*5+c1]);}
 }puts("");return 0;
}
